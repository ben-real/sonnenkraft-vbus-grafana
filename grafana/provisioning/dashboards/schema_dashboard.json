      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "P9C1C620F4ACC4E7B"
          },
          "queryText": "SELECT CAST(strftime('%s', timestamp) AS INTEGER) as time, CASE WHEN temp_sensor_1 BETWEEN -25 AND 140 THEN ROUND(temp_sensor_1) ELSE NULL END as Kollektor_F1, CASE WHEN temp_sensor_2 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_2) ELSE NULL END as Sek_Vorlauf_F2, CASE WHEN temp_sensor_3 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_3) ELSE NULL END as Puffer_Unten_F3, CASE WHEN temp_sensor_4 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_4) ELSE NULL END as Sek_Ruecklauf_F4, CASE WHEN temp_sensor_6 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_6) ELSE NULL END as Boiler_F6, CASE WHEN temp_sensor_7 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_7) ELSE NULL END as Puffer_Mitte_F7, CASE WHEN temp_sensor_8 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_8) ELSE NULL END as Ruecklauf_F8, CASE WHEN pump_speed_a1 BETWEEN 0 AND 100 THEN pump_speed_a1 ELSE 0 END as Pumpe_A1, CASE WHEN pump_speed_a2 BETWEEN 0 AND 100 THEN pump_speed_a2 ELSE 0 END as Pumpe_A2, CASE WHEN pump_speed_a3 BETWEEN 0 AND 100 THEN pump_speed_a3 ELSE 0 END as Ventil_A3, CASE WHEN pump_speed_a BETWEEN 0 AND 100 THEN pump_speed_a ELSE 0 END as Schichtventil_A FROM measurements WHERE temp_sensor_2 IS NOT NULL AND temp_sensor_3 IS NOT NULL ORDER BY timestamp DESC LIMIT 1",
          "queryType": "table",
          "rawQueryText": "SELECT CAST(strftime('%s', timestamp) AS INTEGER) as time, CASE WHEN temp_sensor_1 BETWEEN -25 AND 140 THEN ROUND(temp_sensor_1) ELSE NULL END as Kollektor_F1, CASE WHEN temp_sensor_2 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_2) ELSE NULL END as Sek_Vorlauf_F2, CASE WHEN temp_sensor_3 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_3) ELSE NULL END as Puffer_Unten_F3, CASE WHEN temp_sensor_4 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_4) ELSE NULL END as Sek_Ruecklauf_F4, CASE WHEN temp_sensor_6 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_6) ELSE NULL END as Boiler_F6, CASE WHEN temp_sensor_7 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_7) ELSE NULL END as Puffer_Mitte_F7, CASE WHEN temp_sensor_8 BETWEEN 10 AND 95 THEN ROUND(temp_sensor_8) ELSE NULL END as Ruecklauf_F8, CASE WHEN pump_speed_a1 BETWEEN 0 AND 100 THEN pump_speed_a1 ELSE 0 END as Pumpe_A1, CASE WHEN pump_speed_a2 BETWEEN 0 AND 100 THEN pump_speed_a2 ELSE 0 END as Pumpe_A2, CASE WHEN pump_speed_a3 BETWEEN 0 AND 100 THEN pump_speed_a3 ELSE 0 END as Ventil_A3, CASE WHEN pump_speed_a BETWEEN 0 AND 100 THEN pump_speed_a ELSE 0 END as Schichtventil_A FROM measurements WHERE temp_sensor_2 IS NOT NULL AND temp_sensor_3 IS NOT NULL ORDER BY timestamp DESC LIMIT 1",
          "refId": "A",
          "timeColumns": [
            "time"
          ]
        }
      ],
